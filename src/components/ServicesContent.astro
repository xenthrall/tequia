---
import { getServices } from "../data/services";
import { getStrings } from "../i18n/strings";
import Contact from "./Contact.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = getServices(locale);
const strings = getStrings(locale);
---

<section class="flex flex-col items-center text-center">
  <h1 class="m-0 text-[clamp(1.4rem,4.4vw,1.7rem)] font-[750] leading-[1.15] tracking-[-0.035em] text-[var(--text)]">
    {services.headline}
  </h1>

  <p class="mt-2.5 max-w-[460px] text-[0.9rem] leading-[1.6] text-[var(--muted)]">{services.intro}</p>
</section>

<section class="mt-8" aria-label={strings.services.packagesHeading}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.services.packagesHeading}</h2>

  <div class="flex flex-col gap-3">
    {
      services.packages.map((pkg) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl">
          <h3 class="text-sm font-semibold text-[var(--text)]">{pkg.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--muted)]">{pkg.description}</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {pkg.bullets.map((bullet) => (
              <li class="flex items-start gap-2 text-xs text-[var(--muted)]">
                <span class="mt-0.5 text-[var(--accent)]" aria-hidden="true">
                  ✓
                </span>
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section class="mt-8" aria-label={strings.services.processHeading}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.services.processHeading}</h2>

  <div class="flex flex-col gap-3">
    {
      services.process.map((step) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl">
          <h3 class="text-sm font-semibold text-[var(--text)]">{step.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--muted)]">{step.description}</p>
        </div>
      ))
    }
  </div>
</section>

<Contact locale={locale} title={services.ctaLabel} subtitle={services.contactSubtitle} />
