---
import { getServices } from "../data/services";
import { getStrings } from "../i18n/strings";
import { renderMascotIcon } from "../icons/mascot";
import SectionHeading from "./SectionHeading.astro";
import Contact from "./Contact.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = getServices(locale);
const strings = getStrings(locale);
---

<section class="@container">
  <div class="grid grid-cols-1 gap-3 @3xl:grid-cols-12">
    <div class="tile flex flex-col gap-4 @3xl:col-span-8">
      <p class="eyebrow">{strings.header.nav.services}</p>

      <h1 class="display m-0 max-w-[20ch] text-[clamp(2rem,5vw,3.2rem)] leading-[1.02] text-[var(--text)]">{services.headline}</h1>

      <p class="max-w-[58ch] text-[0.95rem] leading-relaxed text-[var(--muted)]">{services.intro}</p>
    </div>

    <div class="tile group hidden place-items-center border-transparent bg-[var(--accent-soft)] @3xl:col-span-4 @3xl:grid" aria-hidden="true">
      <span
        class="block h-[120px] w-[138px] transition-transform duration-300 ease-[cubic-bezier(.2,.8,.2,1)] group-hover:-translate-y-1 group-hover:scale-105"
        set:html={renderMascotIcon()}
      />
    </div>
  </div>
</section>

<section class="@container" aria-labelledby="packages-heading">
  <SectionHeading id="packages-heading" lead={strings.services.packagesHeading} />

  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-3">
    {
      services.packages.map((pkg) => (
        <div class="tile flex flex-col gap-2.5">
          <h3 class="m-0 font-serif text-[1.35rem] font-normal leading-[1.15] text-[var(--text)]">{pkg.title}</h3>
          <p class="text-[0.9rem] leading-relaxed text-[var(--muted)]">{pkg.description}</p>
          <ul class="mt-auto flex flex-col gap-1.5 border-t border-[var(--border)] pt-3">
            {pkg.bullets.map((bullet) => (
              <li class="flex items-start gap-2 text-[0.86rem] text-[var(--text)]">
                <span class="text-[var(--accent)]" aria-hidden="true">
                  ✓
                </span>
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section class="@container" aria-labelledby="process-heading">
  <SectionHeading id="process-heading" lead={strings.services.processHeading} />

  <ol class="m-0 grid list-none grid-cols-1 gap-3 p-0 @xl:grid-cols-2 @3xl:grid-cols-4">
    {
      services.process.map((step) => (
        <li class="tile flex flex-col gap-2">
          <h3 class="m-0 font-serif text-[1.15rem] font-normal leading-[1.2] text-[var(--text)]">{step.title}</h3>
          <p class="text-[0.88rem] leading-relaxed text-[var(--muted)]">{step.description}</p>
        </li>
      ))
    }
  </ol>
</section>

<Contact locale={locale} title={services.ctaLabel} subtitle={services.contactSubtitle} />
