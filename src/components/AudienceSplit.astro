---
import { getStrings } from "../i18n/strings";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = getStrings(locale);

const cards = [
  {
    href: `/${locale}/services/`,
    icon: "🏢",
    title: strings.audienceSplit.business.title,
    description: strings.audienceSplit.business.description,
    cta: strings.audienceSplit.business.cta,
  },
  {
    href: `/${locale}/hire-me/`,
    icon: "👔",
    title: strings.audienceSplit.recruiter.title,
    description: strings.audienceSplit.recruiter.description,
    cta: strings.audienceSplit.recruiter.cta,
  },
];
---

<section class="mt-8" aria-label={strings.audienceSplit.eyebrow}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.audienceSplit.eyebrow}</h2>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col gap-2 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 text-inherit no-underline shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl transition duration-200 hover:-translate-y-0.5 hover:border-[rgba(var(--accent-rgb),0.35)] hover:bg-[var(--card-hover)]"
        >
          <span class="text-2xl" aria-hidden="true">
            {card.icon}
          </span>
          <h3 class="text-sm font-semibold text-[var(--text)]">{card.title}</h3>
          <p class="text-xs leading-relaxed text-[var(--muted)]">{card.description}</p>
          <span class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-[rgba(var(--accent-rgb),0.14)] px-3 py-1.5 text-xs font-semibold text-[var(--accent)] transition duration-200 group-hover:gap-2 group-hover:bg-[rgba(var(--accent-rgb),0.22)]">
            {card.cta}
            <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
          </span>
        </a>
      ))
    }
  </div>
</section>
