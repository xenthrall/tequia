---
import { getStrings } from "../i18n/strings";
import { localizedPath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = getStrings(locale);

// La ruta de negocio va invertida para que sea lo primero que vea un cliente.
const cards = [
  {
    href: localizedPath("/services/", locale),
    eyebrow: strings.header.nav.services,
    title: strings.audienceSplit.business.title,
    description: strings.audienceSplit.business.description,
    cta: strings.audienceSplit.business.cta,
    inverse: true,
  },
  {
    href: localizedPath("/hire-me/", locale),
    eyebrow: strings.header.nav.hireMe,
    title: strings.audienceSplit.recruiter.title,
    description: strings.audienceSplit.recruiter.description,
    cta: strings.audienceSplit.recruiter.cta,
    inverse: false,
  },
];
---

<section class="@container mt-3" aria-label={strings.audienceSplit.eyebrow}>
  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-2">
    {
      cards.map((card) => (
        <a href={card.href} class:list={["tile group flex flex-col gap-2.5", card.inverse && "tile-inverse hover:!border-[var(--accent)]"]}>
          <span class:list={["eyebrow", card.inverse && "!text-[var(--on-inverse-muted)]"]}>{card.eyebrow}</span>

          <h2 class="display m-0 mt-1.5 text-[clamp(1.8rem,3.6vw,2.6rem)] leading-[1.02] tracking-[-0.025em] group-hover:italic">
            {card.title}
          </h2>

          <p class:list={["text-[0.95rem]", card.inverse ? "text-[var(--on-inverse-muted)]" : "text-[var(--muted)]"]}>{card.description}</p>

          <span class="mt-auto flex items-center justify-between pt-[18px] text-[0.9rem] font-semibold">
            {card.cta}
            <span
              aria-hidden="true"
              class="grid h-[38px] w-[38px] place-items-center rounded-full border border-current transition-transform duration-200 group-hover:-rotate-45"
            >
              →
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
