---
import { uiIcons } from "../icons/ui";
import { getStrings } from "../i18n/strings";
import { localizedPath, type Locale } from "../i18n/config";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = getStrings(locale);

const homePath = localizedPath("/", locale);

const navLinks = [
  { href: localizedPath("/services/", locale), label: strings.header.nav.services },
  { href: localizedPath("/hire-me/", locale), label: strings.header.nav.hireMe },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
const isHome = currentPath === homePath;
---

<header class="flex items-center justify-between gap-3 pb-[18px] pt-2">
  <a href={homePath} class="flex items-baseline gap-2.5 text-[var(--text)] no-underline" aria-label={strings.header.backToHome}>
    <b class="font-serif text-[1.3rem] font-medium italic leading-none tracking-[-0.01em]">Jhon Tequia</b>
    <span class="eyebrow hidden sm:inline">tequia.dev</span>
  </a>

  <nav class="flex items-center gap-1" aria-label="Main">
    {
      !isHome && (
        <a
          href={homePath}
          class="mr-1 inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] py-[7px] pl-2.5 pr-3.5 text-[0.86rem] font-medium text-[var(--text)] no-underline transition duration-150 hover:border-[var(--text)] [&_svg]:h-4 [&_svg]:w-4"
        >
          <Fragment set:html={uiIcons.arrowLeft} />
          {strings.header.nav.home}
        </a>
      )
    }

    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class="hidden rounded-full px-3 py-[7px] text-[0.86rem] text-[var(--muted)] no-underline transition duration-150 hover:bg-[var(--card)] hover:text-[var(--text)] aria-[current=page]:text-[var(--text)] sm:block"
        >
          {link.label}
        </a>
      ))
    }

    <button
      class="grid h-9 w-9 place-items-center rounded-full text-[var(--muted)] transition duration-150 hover:bg-[var(--card)] hover:text-[var(--text)] active:scale-[0.94] [&_svg]:h-[18px] [&_svg]:w-[18px] [&_svg]:animate-[icon-pop_260ms_ease]"
      type="button"
      aria-label={strings.header.themeToggle}
      id="theme-toggle"
    >
      <Fragment set:html={uiIcons.theme} />
    </button>

    <LanguageSwitcher locale={locale} />
  </nav>
</header>
