---
import { uiIcons } from "../icons/ui";
import { getStrings } from "../i18n/strings";
import { localizedPath, type Locale } from "../i18n/config";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = getStrings(locale);

const homePath = localizedPath("/", locale);
const isHome = Astro.url.pathname === homePath;

const iconButtonClasses =
  "grid h-10 w-10 place-items-center rounded-full border border-[var(--border)] bg-[var(--card)] text-[var(--text)] backdrop-blur-[14px] transition duration-200 hover:-translate-y-0.5 hover:border-white/20 hover:bg-[var(--card-hover)] active:scale-[0.94] disabled:pointer-events-none disabled:cursor-default disabled:opacity-40 sm:h-[42px] sm:w-[42px] [&_svg]:h-[19px] [&_svg]:w-[19px] [&_svg]:animate-[icon-pop_260ms_ease]";
---

<header class:list={["mb-[14px] flex items-center gap-2.5 sm:mb-[18px]", isHome ? "justify-center" : "justify-between"]}>
  {
    !isHome && (
      <a
        href={homePath}
        aria-label={strings.header.backToHome}
        class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--card)] py-2 pl-2.5 pr-3.5 text-xs font-medium text-[var(--text)] no-underline backdrop-blur-[14px] transition duration-200 hover:-translate-y-0.5 hover:border-white/20 hover:bg-[var(--card-hover)] [&_svg]:h-4 [&_svg]:w-4"
      >
        <Fragment set:html={uiIcons.arrowLeft} />
        {strings.header.backToHome}
      </a>
    )
  }

  <div class="flex items-center gap-2.5">
    <button class={iconButtonClasses} type="button" aria-label={strings.header.themeToggle} id="theme-toggle">
      <Fragment set:html={uiIcons.theme} />
    </button>

    <LanguageSwitcher locale={locale} />
  </div>
</header>
