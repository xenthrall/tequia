---
// Estado de disponibilidad: la forma discreta de decir "estoy abierto a
// trabajo" sin que la home se sienta como una oferta (docs/vision.md §0).
// Si deja de estar disponible, basta con quitar este bloque de la home.
import { getStrings } from "../i18n/strings";
import { renderMascotIcon } from "../icons/mascot";
import { sectionPath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  // En la página "Trabajemos" el bloque ya está en destino: sin botón.
  showCta?: boolean;
}

const { locale, showCta = true } = Astro.props;
const { availability } = getStrings(locale);
---

<section class="@container mt-3" aria-label={availability.title}>
  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-12">
    <div class="tile tile-inverse flex flex-col gap-3 @2xl:col-span-9">
      <span class="eyebrow flex items-center gap-2 !text-[var(--on-inverse-muted)]">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {availability.eyebrow}
      </span>

      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
        <div class="flex max-w-[56ch] flex-col gap-2">
          <h2 class="display m-0 text-[clamp(1.7rem,3.4vw,2.4rem)] leading-[1.05]">{availability.title}</h2>
          <p class="text-[0.95rem] text-[var(--on-inverse-muted)]">{availability.description}</p>
        </div>

        {
          showCta && (
            <a
              href={sectionPath(locale, "work")}
              class="group flex items-center gap-3 text-[0.9rem] font-semibold text-[var(--on-inverse)] no-underline"
            >
              {availability.cta}
              <span
                aria-hidden="true"
                class="grid h-[38px] w-[38px] place-items-center rounded-full border border-current transition-transform duration-200 group-hover:-rotate-45"
              >
                →
              </span>
            </a>
          )
        }
      </div>
    </div>

    <div class="tile group hidden place-items-center border-transparent bg-[var(--accent-soft)] @2xl:col-span-3 @2xl:grid" aria-hidden="true">
      <span
        class="block h-[92px] w-[106px] transition-transform duration-300 ease-[cubic-bezier(.2,.8,.2,1)] group-hover:-translate-y-1 group-hover:scale-105"
        set:html={renderMascotIcon()}
      />
    </div>
  </div>
</section>
