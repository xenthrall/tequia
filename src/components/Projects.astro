---
import { getProjects } from "../data/projects";
import { renderBrandIcon } from "../icons/brands";
import { getStrings } from "../i18n/strings";
import SectionHeading from "./SectionHeading.astro";
import ProjectPreview from "./ProjectPreview.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = getProjects(locale);
const strings = getStrings(locale);
---

<section class="@container" id="projects" aria-labelledby="projects-heading">
  <SectionHeading
    id="projects-heading"
    lead={strings.projects.heading.lead}
    emphasis={strings.projects.heading.emphasis}
    meta={`${projects.length} ${strings.projects.countLabel}`}
  />

  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-2 @4xl:grid-cols-12">
    {
      projects.map((project) => {
        const isLink = Boolean(project.url);
        const Tag = isLink ? "a" : "div";
        const hostname = project.url ? new URL(project.url).hostname : null;

        return (
          <Tag
            {...(isLink ? { href: project.url!, target: "_blank", rel: "noopener noreferrer" } : {})}
            class:list={[
              "tile flex flex-col gap-2.5",
              project.featured ? "@2xl:col-span-2 @4xl:col-span-7 @4xl:row-span-2" : "@4xl:col-span-5",
            ]}
          >
            <div class="flex items-center justify-between gap-2">
              <span class="eyebrow">{project.kicker}</span>
              {project.badge && <span class="badge">{project.badge}</span>}
            </div>

            <h3
              class:list={[
                "display m-0 leading-[1.05] tracking-[-0.02em] text-[var(--text)]",
                project.featured ? "text-[clamp(2rem,4vw,2.8rem)]" : "text-[1.7rem]",
              ]}
            >
              {project.title}
            </h3>

            <p class="text-[0.95rem] text-[var(--muted)]">{project.description}</p>

            {project.preview && <ProjectPreview locale={locale} type={project.preview} />}

            <div class="mt-auto flex flex-wrap gap-1.5 pt-1.5">
              {project.technologies.map(({ name, icon }) => (
                <span class="tag [&_svg]:h-3 [&_svg]:w-3 [&_svg]:opacity-70" set:html={`${renderBrandIcon(icon)}${name}`} />
              ))}
            </div>

            {hostname && (
              <span class="text-[0.85rem] font-semibold text-[var(--accent)]">
                {project.featured ? hostname : strings.projects.viewProject} <span aria-hidden="true">↗</span>
              </span>
            )}
          </Tag>
        );
      })
    }
  </div>
</section>
