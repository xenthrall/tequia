---
import { getHireMe } from "../data/hire-me";
import { getProfile } from "../data/profile";
import { getStrings } from "../i18n/strings";
import { withBase } from "../lib/base-url";
import SectionHeading from "./SectionHeading.astro";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hireMe = getHireMe(locale);
const profile = getProfile(locale);
const strings = getStrings(locale);
---

<section class="@container">
  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-3">
    <div class="tile flex flex-col gap-4 @2xl:col-span-2">
      <p class="eyebrow">{hireMe.location}</p>

      <h1 class="display m-0 text-[clamp(2rem,5vw,3.2rem)] leading-[1.02] text-[var(--text)]">{hireMe.headline}</h1>

      <p class="max-w-[52ch] text-[0.95rem] leading-relaxed text-[var(--muted)]">{hireMe.modality}</p>

      <div class="flex flex-wrap gap-2">
        {hireMe.availability.map((item) => <span class="badge">{item}</span>)}
      </div>

      <a
        href={withBase(hireMe.cvUrl)}
        download
        class="mt-2 inline-flex w-fit items-center gap-2 rounded-full bg-[var(--text)] px-5 py-3 text-sm font-semibold text-[var(--background)] no-underline transition hover:bg-[var(--accent)] hover:text-white"
      >
        {hireMe.cvLabel} <span aria-hidden="true">↓</span>
      </a>
    </div>

    <figure class="tile relative m-0 hidden min-h-[240px] overflow-hidden p-0 @2xl:block">
      <img src={withBase(profile.avatar)} alt={profile.name} class="absolute inset-0 h-full w-full object-cover object-[center_30%]" />
    </figure>
  </div>
</section>

<section class="@container" aria-labelledby="stack-heading">
  <SectionHeading id="stack-heading" lead={strings.hireMe.stack} />

  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-3">
    {
      hireMe.stackGroups.map((group) => (
        <div class="tile flex flex-col gap-3">
          <span class="eyebrow">{group.label}</span>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section aria-labelledby="experience-heading">
  <SectionHeading id="experience-heading" lead={strings.hireMe.experience} />

  <div class="flex flex-col gap-3">
    {
      hireMe.experience.map((item) => (
        <div class="tile flex flex-col gap-2">
          <h3 class="m-0 font-serif text-[1.35rem] font-normal leading-[1.15] text-[var(--text)]">{item.role}</h3>
          <span class="text-[0.9rem] font-semibold text-[var(--accent)]">{item.organization}</span>
          <p class="text-[0.95rem] leading-relaxed text-[var(--muted)]">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="@container" aria-labelledby="education-heading">
  <SectionHeading id="education-heading" lead={strings.hireMe.education} />

  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-2">
    {
      hireMe.education.map((item) => (
        <div class="tile flex flex-col gap-2">
          <h3 class="m-0 font-serif text-[1.2rem] font-normal leading-[1.2] text-[var(--text)]">{item.title}</h3>
          <span class="text-[0.9rem] font-semibold text-[var(--accent)]">{item.institution}</span>
          {item.description && <p class="text-[0.9rem] text-[var(--muted)]">{item.description}</p>}
        </div>
      ))
    }
  </div>
</section>

<Projects locale={locale} />

<Contact locale={locale} title={hireMe.ctaLabel} subtitle={hireMe.contactSubtitle} />
