---
import { getHireMe } from "../data/hire-me";
import { getProfile } from "../data/profile";
import { getStrings } from "../i18n/strings";
import { withBase } from "../lib/base-url";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hireMe = getHireMe(locale);
const profile = getProfile(locale);
const strings = getStrings(locale);
---

<section class="flex flex-col items-center text-center">
  <div
    class="mb-4 grid h-[92px] w-[92px] place-items-center overflow-hidden rounded-full border border-white/[0.18] bg-[linear-gradient(145deg,#303030,#181818)] shadow-[0_20px_50px_rgba(0,0,0,0.45),inset_0_1px_rgba(255,255,255,0.12)] sm:h-[104px] sm:w-[104px]"
  >
    <img src={withBase(profile.avatar)} alt={profile.name} class="h-full w-full object-cover" />
  </div>

  <h1 class="m-0 text-[clamp(1.4rem,4.4vw,1.7rem)] font-[750] leading-[1.15] tracking-[-0.035em] text-[var(--text)]">
    {hireMe.headline}
  </h1>

  <p class="mt-2.5 text-sm leading-relaxed text-[var(--muted)]">{hireMe.location}</p>
  <p class="mt-1 max-w-[420px] text-[0.84rem] leading-[1.55] text-[var(--muted)]">{hireMe.modality}</p>

  <div class="mt-3 flex flex-wrap justify-center gap-2">
    {
      hireMe.availability.map((item) => (
        <span class="rounded-full border border-[rgba(var(--accent-rgb),0.3)] bg-[rgba(var(--accent-rgb),0.14)] px-3 py-1 text-xs font-semibold text-[var(--accent)]">
          {item}
        </span>
      ))
    }
  </div>

  <a
    href={withBase(hireMe.cvUrl)}
    download
    class="mt-5 inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-[#a78bfa] to-[#6d28d9] px-4 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5"
  >
    {hireMe.cvLabel}
  </a>
</section>

<section class="mt-8" aria-label={strings.hireMe.stack}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.hireMe.stack}</h2>

  <div class="flex flex-col gap-3">
    {
      hireMe.stackGroups.map((group) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{group.label}</p>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <span class="rounded-full border border-[var(--border)] bg-[var(--card)] px-2.5 py-1 text-[11px] text-[var(--muted)]">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="mt-8" aria-label={strings.hireMe.experience}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.hireMe.experience}</h2>

  <div class="flex flex-col gap-3">
    {
      hireMe.experience.map((item) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl">
          <h3 class="text-sm font-semibold text-[var(--text)]">{item.role}</h3>
          <p class="mt-0.5 text-xs font-medium text-[var(--accent)]">{item.organization}</p>
          <p class="mt-2 text-xs leading-relaxed text-[var(--muted)]">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="mt-8" aria-label={strings.hireMe.education}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.hireMe.education}</h2>

  <div class="flex flex-col gap-3">
    {
      hireMe.education.map((item) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl">
          <h3 class="text-sm font-semibold text-[var(--text)]">{item.title}</h3>
          <p class="mt-0.5 text-xs font-medium text-[var(--accent)]">{item.institution}</p>
          {item.description && <p class="mt-2 text-xs leading-relaxed text-[var(--muted)]">{item.description}</p>}
        </div>
      ))
    }
  </div>
</section>

<Projects locale={locale} />

<Contact locale={locale} title={hireMe.ctaLabel} subtitle={hireMe.contactSubtitle} />
