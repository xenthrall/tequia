---
import { locales, localizedPath, type Locale } from "../i18n/config";
import { getStrings } from "../i18n/strings";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = getStrings(locale);
---

<details class="relative">
  <summary
    class="cursor-pointer list-none rounded-full border border-[var(--border)] px-3 py-[7px] font-mono text-[0.72rem] font-medium uppercase leading-[1.4] text-[var(--text)] transition duration-150 marker:content-none hover:border-[var(--text)] [&::-webkit-details-marker]:hidden"
    aria-label={strings.header.languageSwitcher}
  >
    {locale}
  </summary>

  <div class="absolute right-0 top-[calc(100%+8px)] z-10 min-w-[140px] overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-[0_14px_40px_rgba(0,0,0,0.18)]">
    {
      locales.map((l) => {
        const href = localizedPath(Astro.url.pathname, l.code);
        return (
          <a
            href={href}
            lang={l.htmlLang}
            class:list={[
              "block px-4 py-2.5 text-sm no-underline transition duration-150",
              l.code === locale
                ? "bg-[var(--accent-soft)] font-semibold text-[var(--accent)]"
                : "text-[var(--text)] hover:bg-[var(--card-hover)]",
            ]}
          >
            {l.label}
          </a>
        );
      })
    }
  </div>
</details>
