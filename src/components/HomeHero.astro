---
import { getProfile } from "../data/profile";
import { socialLinks } from "../data/social-links";
import { getStrings } from "../i18n/strings";
import { withBase } from "../lib/base-url";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const strings = getStrings(locale);
---

<section class="@container">
  <div class="grid grid-cols-2 gap-3 @3xl:grid-cols-12">
    <div class="tile col-span-2 flex flex-col justify-between gap-6 @3xl:col-span-8 @3xl:row-span-2">
      <p class="eyebrow">{profile.role}</p>

      <h1 class="display m-0 max-w-[13ch] text-[clamp(2.5rem,6.3vw,5rem)] font-[360] leading-[0.98] tracking-[-0.035em] text-[var(--text)]">
        {profile.headline.lead} <em>{profile.headline.emphasis}</em>
      </h1>

      <div class="flex flex-wrap items-end justify-between gap-x-7 gap-y-4">
        <p class="max-w-[50ch] text-[0.95rem] leading-[1.6] text-[var(--muted)]">{profile.description}</p>

        <div class="flex flex-wrap gap-1.5">
          {
            socialLinks.map(({ name, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="pill-link">
                {name} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <figure class="tile relative m-0 flex min-h-[190px] flex-col justify-end overflow-hidden p-0 @3xl:col-span-4 @3xl:min-h-[240px]">
      <img
        src={withBase(profile.avatar)}
        alt={profile.name}
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        width="480"
        height="480"
      />
      <figcaption
        class="relative m-2.5 flex items-baseline justify-between gap-2 rounded-[14px] bg-[color-mix(in_srgb,var(--card)_88%,transparent)] px-3.5 py-2.5 backdrop-blur-md"
      >
        <b class="font-serif text-[1.05rem] font-medium italic">{profile.name}</b>
        <span class="eyebrow hidden @md:inline">{profile.location}</span>
      </figcaption>
    </figure>

    <div class="tile flex flex-col justify-between gap-4 @3xl:col-span-4">
      <p class="eyebrow">{strings.hero.clockLabel}</p>
      <div class="flex flex-col items-start justify-between gap-1 @md:flex-row @md:items-end">
        <span
          data-bogota-clock
          class="font-serif text-[clamp(2.3rem,5vw,3.4rem)] font-[350] leading-none tracking-[-0.03em] tabular-nums lining-nums"
        >
          --:--
        </span>
        <span class="eyebrow">UTC−5</span>
      </div>
    </div>
  </div>
</section>

<script>
  const clock = document.querySelector<HTMLElement>("[data-bogota-clock]");

  if (clock) {
    const format = new Intl.DateTimeFormat("es-CO", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "America/Bogota",
    });

    const tick = () => {
      clock.textContent = format.format(new Date());
    };

    tick();
    setInterval(tick, 15_000);
  }
</script>
