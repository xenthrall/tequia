---
import { getProfile } from "../data/profile";
import { socialLinks } from "../data/social-links";
import { getStrings } from "../i18n/strings";
import { withBase } from "../lib/base-url";
import { getNotes, notePath } from "../lib/notes";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const strings = getStrings(locale);

// Bloque "última nota": la fecha no se muestra a propósito (ver docs/vision.md
// §13, la home no debe delatar cuánto tiempo pasa entre notas).
const [latestNote] = await getNotes(locale);
---

<section class="@container">
  <div class="grid grid-cols-2 gap-3 @3xl:grid-cols-12">
    <div class="tile col-span-2 flex flex-col justify-between gap-6 @3xl:col-span-8 @3xl:row-span-2">
      <p class="eyebrow">{profile.role}</p>

      <h1 class="display m-0 max-w-[13ch] text-[clamp(2.5rem,6.3vw,5rem)] font-[360] leading-[0.98] tracking-[-0.035em] text-[var(--text)]">
        {profile.headline.lead} <em>{profile.headline.emphasis}</em>
      </h1>

      <div class="flex flex-wrap items-end justify-between gap-x-7 gap-y-4">
        <p class="max-w-[50ch] text-[0.95rem] leading-[1.6] text-[var(--muted)]">{profile.description}</p>

        <div class="flex flex-wrap gap-1.5">
          {
            socialLinks.map(({ name, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="pill-link">
                {name} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <figure class="tile relative col-span-2 m-0 flex min-h-[190px] flex-col justify-end overflow-hidden p-0 @3xl:col-span-4 @3xl:min-h-[240px]">
      <img
        src={withBase(profile.avatar)}
        alt={profile.name}
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        width="480"
        height="480"
      />
      <figcaption
        class="relative m-2.5 flex items-baseline justify-between gap-2 rounded-[14px] bg-[color-mix(in_srgb,var(--card)_88%,transparent)] px-3.5 py-2.5 backdrop-blur-md"
      >
        <b class="font-serif text-[1.05rem] font-medium italic">{profile.name}</b>
        <span class="eyebrow hidden @md:inline">{profile.location}</span>
      </figcaption>
    </figure>

    {
      latestNote ? (
        <a
          href={notePath(latestNote)}
          class="tile group col-span-2 flex flex-col gap-4 @3xl:col-span-4"
          data-home-clock
          data-status={JSON.stringify(strings.hero.status)}
        >
          <p class="eyebrow flex flex-wrap items-baseline gap-x-1.5">
            <span data-clock-time class="tabular-nums text-[var(--text)]">--:--</span>
            <span>Bogotá</span>
            <span aria-hidden="true">·</span>
            <span data-clock-status class="normal-case tracking-normal">UTC−5</span>
          </p>

          <div class="flex flex-1 flex-col gap-2 border-t border-[var(--border)] pt-4">
            <span class="eyebrow">{strings.hero.latestNote}</span>
            <span class="font-serif text-[1.5rem] font-[380] leading-[1.1] tracking-[-0.02em] text-[var(--text)] transition-colors duration-150 group-hover:text-[var(--accent)]">
              {latestNote.data.title}
            </span>
            <p class="line-clamp-3 font-serif text-[1rem] italic leading-[1.45] text-[var(--muted)]">
              “{latestNote.data.highlight ?? latestNote.data.description}”
            </p>
          </div>

          <span class="text-[0.85rem] font-semibold text-[var(--accent)]">
            {strings.hero.readNote} <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      ) : (
        <div class="tile col-span-2 flex flex-col justify-between gap-4 @3xl:col-span-4" data-home-clock>
          <p class="eyebrow">{strings.hero.clockLabel}</p>
          <div class="flex flex-col items-start justify-between gap-1 @md:flex-row @md:items-end">
            <span
              data-clock-time
              class="font-serif text-[clamp(2.3rem,5vw,3.4rem)] font-[350] leading-none tracking-[-0.03em] tabular-nums lining-nums"
            >
              --:--
            </span>
            <span class="eyebrow">UTC−5</span>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  // Hora de Bogotá y, si el bloque trae `data-status`, una frase según la hora
  // ("seguramente programando"). Sin JS queda "--:--" y "UTC−5".
  const block = document.querySelector<HTMLElement>("[data-home-clock]");
  const time = block?.querySelector<HTMLElement>("[data-clock-time]");
  const status = block?.querySelector<HTMLElement>("[data-clock-status]");
  const schedule: { until: number; text: string }[] = JSON.parse(block?.dataset.status ?? "[]");

  if (time) {
    const format = new Intl.DateTimeFormat("es-CO", {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: "America/Bogota",
    });

    const tick = () => {
      const parts = format.formatToParts(new Date());
      const hour = Number(parts.find((part) => part.type === "hour")?.value);
      const minute = parts.find((part) => part.type === "minute")?.value;

      time.textContent = `${String(hour).padStart(2, "0")}:${minute}`;

      const current = schedule.find((slot) => hour < slot.until);
      if (status && current) status.textContent = current.text;
    };

    tick();
    setInterval(tick, 15_000);
  }
</script>
