---
// Página puente en la URL vieja de un experimento que fue promovido a
// proyecto: los enlaces compartidos siguen funcionando. Canonical a la nueva.
import { siteUrl } from "../../i18n/config";

interface Props {
  to: string;
}

const { to } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${siteUrl}${to}`} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <title>→ {to}</title>
  </head>
  <body>
    <a href={to}>{to}</a>
  </body>
</html>
