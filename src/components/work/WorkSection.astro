---
// Sección de proyectos o experimentos: en la home (con "Ver todos"), en su
// página índice y en /hire-me. En experimentos se suma un bloque que explica
// cómo crece un experimento (docs/vision.md §14).
import SectionHeading from "../SectionHeading.astro";
import WorkCard from "./WorkCard.astro";
import { getStrings } from "../../i18n/strings";
import type { Locale } from "../../i18n/config";
import { getWork, workIndexPath, type WorkKind } from "../../lib/projects";

interface Props {
  locale: Locale;
  kind: WorkKind;
  // En la home: enlace "Ver todos" hacia el índice de la sección.
  linkToIndex?: boolean;
  // En el índice: párrafo de introducción sobre la grilla.
  showIntro?: boolean;
}

const { locale, kind, linkToIndex = false, showIntro = false } = Astro.props;
const strings = getStrings(locale);
const section = strings.work[kind];
const items = await getWork(locale, kind);
const id = `${kind}-heading`;
---

<section class="@container" id={kind === "project" ? "projects" : "experiments"} aria-labelledby={id}>
  <SectionHeading
    id={id}
    lead={section.heading.lead}
    emphasis={section.heading.emphasis}
    meta={section.count(items.length)}
    link={linkToIndex ? { href: workIndexPath(locale, kind), label: strings.work.viewAll } : undefined}
  />

  {showIntro && <p class="max-w-[62ch] px-1 pb-4 text-[0.95rem] leading-relaxed text-[var(--muted)]">{section.intro}</p>}

  <div class="grid grid-cols-1 gap-3 @2xl:grid-cols-2 @4xl:grid-cols-12">
    {items.map((work) => <WorkCard work={work} class={work.data.featured ? "@2xl:col-span-2 @4xl:col-span-7" : "@4xl:col-span-5"} />)}

    {
      kind === "experiment" && (
        <div class="tile flex flex-col justify-between gap-4 border-dashed bg-transparent @4xl:col-span-5">
          <div class="flex flex-col gap-2.5">
            <span class="eyebrow">{strings.work.lifecycle.title}</span>
            <p class="font-serif text-[1.25rem] font-[380] leading-[1.3] tracking-[-0.01em] text-[var(--text)]">
              {strings.work.lifecycle.description}
            </p>
          </div>
          <p class="eyebrow flex flex-wrap items-center gap-2">
            <span>{strings.work.experiment.title}</span>
            <span aria-hidden="true">→</span>
            <span class="text-[var(--accent)]">{strings.work.project.title}</span>
          </p>
        </div>
      )
    }
  </div>
</section>
