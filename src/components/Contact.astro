---
import { siWhatsapp } from "simple-icons";
import { getContact } from "../data/contact";
import { renderBrandIcon } from "../icons/brands";
import { getStrings } from "../i18n/strings";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  title?: string;
  subtitle?: string;
}

const { locale, title, subtitle } = Astro.props;
const contact = getContact(locale);
const strings = getStrings(locale);

const whatsappContactUrl = `https://wa.me/${contact.whatsapp.number}?text=${encodeURIComponent(contact.whatsapp.message)}`;

interface ContactField {
  id: string;
  name: string;
  label: string;
  type: "text" | "email" | "tel" | "textarea";
  required?: boolean;
  optional?: boolean;
  autocomplete?: string;
  placeholder?: string;
}

const fields: ContactField[] = [
  {
    id: "contact-name",
    name: "name",
    label: strings.contact.fields.name,
    type: "text",
    required: true,
    autocomplete: "name",
    placeholder: strings.contact.placeholders.name,
  },
  {
    id: "contact-email",
    name: "email",
    label: strings.contact.fields.email,
    type: "email",
    required: true,
    autocomplete: "email",
    placeholder: strings.contact.placeholders.email,
  },
  {
    id: "contact-phone",
    name: "phone",
    label: strings.contact.fields.phone,
    type: "tel",
    optional: true,
    autocomplete: "tel",
    placeholder: strings.contact.placeholders.phone,
  },
  {
    id: "contact-message",
    name: "message",
    label: strings.contact.fields.message,
    type: "textarea",
    required: true,
    placeholder: strings.contact.placeholders.message,
  },
];

const fieldClass =
  "w-full rounded-xl border border-[var(--border)] bg-[var(--background)] px-3.5 py-2.5 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-transparent focus:ring-2 focus:ring-[rgba(var(--accent-rgb),0.5)] aria-invalid:border-[var(--danger)] aria-invalid:focus:ring-[rgba(var(--danger-rgb),0.4)]";
---

<section class="mt-8" aria-label={strings.sections.contact}>
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--soft)]">{strings.sections.contact}</h2>

  <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl sm:p-6">
    <h3 class="text-base font-semibold text-[var(--text)]">{title ?? strings.contact.title}</h3>

    <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">
      {subtitle ?? strings.contact.subtitle}
    </p>

    <div
      data-fs-error
      aria-live="polite"
      class="mt-5 hidden items-center gap-2 rounded-xl border border-[rgba(var(--danger-rgb),0.3)] bg-[rgba(var(--danger-rgb),0.12)] px-4 py-3 text-sm text-[var(--danger)] data-[fs-active]:flex"
    >
      {strings.contact.errorMessage}
    </div>

    <div id="contact-form-area" aria-live="polite">
      <form id="contact-form" class="mt-5 flex flex-col gap-4">
        {
          fields.map((field) => (
            <div>
              <label for={field.id} class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
                {field.label}
                {field.optional && <span class="text-[var(--soft)]"> {strings.contact.optional}</span>}
              </label>

              {field.type === "textarea" ? (
                <textarea
                  id={field.id}
                  name={field.name}
                  rows={4}
                  required={field.required}
                  data-fs-field
                  placeholder={field.placeholder ?? ""}
                  class:list={[fieldClass, "resize-none"]}
                />
              ) : (
                <input
                  id={field.id}
                  name={field.name}
                  type={field.type}
                  autocomplete={field.autocomplete}
                  required={field.required}
                  data-fs-field
                  placeholder={field.placeholder ?? ""}
                  class={fieldClass}
                />
              )}

              <p data-fs-error={field.name} aria-live="polite" class="mt-1 hidden text-xs text-[var(--danger)] data-[fs-active]:block" />
            </div>
          ))
        }

        <button
          type="submit"
          data-fs-submit-btn
          class="group mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-[#a78bfa] to-[#6d28d9] px-4 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0"
        >
          <span class="group-disabled:hidden">{strings.contact.submit}</span>

          <span class="hidden items-center gap-2 group-disabled:inline-flex" aria-hidden="true">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
            {strings.contact.submitting}
          </span>
        </button>
      </form>
    </div>
  </div>

  <div class="mt-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 text-center shadow-[0_10px_35px_rgba(0,0,0,0.12)] backdrop-blur-xl sm:p-6">
    <p class="text-sm text-[var(--muted)]">{strings.contact.whatsappPrompt}</p>

    <a
      href={whatsappContactUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--card-hover)] px-4 py-2.5 text-sm font-medium text-[var(--text)] transition hover:-translate-y-0.5 hover:border-[#25d366]/40 sm:w-auto"
    >
      <span class="text-[#25d366] [&_svg]:h-4 [&_svg]:w-4" set:html={renderBrandIcon(siWhatsapp)} />
      {strings.contact.whatsappButton}
    </a>
  </div>
</section>

<script>
  import { initForm } from "@formspree/ajax";
  import { getContact } from "../data/contact";
  import { getStrings } from "../i18n/strings";
  import { isLocale, defaultLocale } from "../i18n/config";

  const locale = (() => {
    const htmlLang = document.documentElement.lang;
    return isLocale(htmlLang) ? htmlLang : defaultLocale;
  })();

  const contact = getContact(locale);
  const strings = getStrings(locale);

  function renderThankYouMessage(): string {
    return `
      <div class="mt-5 flex flex-col items-center gap-3 py-4 text-center">
        <span class="grid h-12 w-12 place-items-center rounded-full border border-[rgba(var(--success-rgb),0.3)] bg-[rgba(var(--success-rgb),0.12)] text-[var(--success)]">
          <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true">
            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>

        <h4 class="text-base font-semibold text-[var(--text)]">${strings.contact.thankYouTitle}</h4>

        <p class="max-w-xs text-sm leading-relaxed text-[var(--muted)]">
          ${strings.contact.thankYouMessage}
        </p>
      </div>
    `;
  }

  // Formspree/ajax's default disable()/enable() read and rewrite the submit
  // button's textContent, which merges our two <span> states (label + spinner)
  // into one flat string and corrupts the button on re-enable. We replace both
  // with versions that only toggle the `disabled` attribute.
  function disableSubmit({ form }: { form: HTMLFormElement }) {
    form.setAttribute("aria-busy", "true");
    form.querySelectorAll<HTMLButtonElement>("[data-fs-submit-btn]").forEach((button) => {
      button.disabled = true;
    });
  }

  function enableSubmit({ form }: { form: HTMLFormElement }) {
    form.removeAttribute("aria-busy");
    form.querySelectorAll<HTMLButtonElement>("[data-fs-submit-btn]").forEach((button) => {
      button.disabled = false;
    });
  }

  const formArea = document.querySelector("#contact-form-area");

  initForm({
    formElement: "#contact-form",
    formId: contact.formspreeId,
    useDefaultStyles: false,
    disable: disableSubmit,
    enable: enableSubmit,
    onSuccess: () => {
      if (formArea) formArea.innerHTML = renderThankYouMessage();
    },
  });
</script>
