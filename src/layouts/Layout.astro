---
import "../styles/global.css";
import { withBase } from "../lib/base-url";
import { locales, siteUrl, alternateLinks, defaultLocale, type Locale, type LocalePaths } from "../i18n/config";
import { getProfile } from "../data/profile";
import { getStrings } from "../i18n/strings";
import { notesRssPath } from "../lib/notes";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  // Rutas por idioma cuando no basta con cambiar el prefijo (ver LocalePaths).
  localePaths?: LocalePaths;
  // Presente en páginas de una nota: og:type "article" y sus metadatos.
  article?: { publishedTime: Date; modifiedTime?: Date; tags: string[] };
  // JSON-LD adicional al de `Person` (p.ej. BlogPosting en una nota).
  jsonLd?: Record<string, unknown>[];
}

const { locale, title = "Jhon Tequia", description, localePaths, article, jsonLd = [] } = Astro.props;

const profile = getProfile(locale);
const strings = getStrings(locale);
const pageDescription = description ?? profile.description;

const alternates = localePaths
  ? locales
      .filter(({ code }) => localePaths[code].translated)
      .map(({ code }) => ({ locale: code, href: `${siteUrl}${localePaths[code].path}` }))
  : alternateLinks(Astro.url.pathname);
const canonicalUrl = localePaths
  ? `${siteUrl}${localePaths[locale].path}`
  : (alternates.find((alt) => alt.locale === locale)?.href ?? `${siteUrl}/${defaultLocale}/`);
// Sin traducciones reales no hay grupo de hreflang que declarar.
const hasAlternates = alternates.length > 1;
const defaultAlternate = alternates.find((alt) => alt.locale === defaultLocale);

const ogImage = `${siteUrl}${withBase("profile.webp")}`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: profile.description,
  url: canonicalUrl,
  image: ogImage,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={pageDescription} />

    <link rel="canonical" href={canonicalUrl} />
    {
      hasAlternates && alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    {hasAlternates && defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${strings.notes.title} — ${profile.name}`}
      href={`${siteUrl}${notesRssPath(locale)}`}
    />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === "es" ? "es_CO" : "en_US"} />
    {
      locales
        .filter((l) => l.code !== locale)
        .map((l) => <meta property="og:locale:alternate" content={l.code === "es" ? "es_CO" : "en_US"} />)
    }

    {
      article && (
        <Fragment>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </Fragment>
      )
    }

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Geist:wght@400..600&family=JetBrains+Mono:wght@500&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="alternate icon" href={withBase("favicon.ico")} />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}

    <script is:inline>
      // Sin preferencia guardada, se sigue el tema del sistema operativo.
      try {
        var storedTheme = localStorage.getItem("theme");
        var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        if (storedTheme === "light" || (!storedTheme && prefersLight)) {
          document.documentElement.classList.add("light-mode");
        }
      } catch {}
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
