---
import WorkView from "../../../components/work/WorkView.astro";
import { getWork, workSlug, type Work } from "../../../lib/projects";

export async function getStaticPaths() {
  const projects = await getWork("es", "project");
  return projects.map((work) => ({ params: { slug: workSlug(work) }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
---

<WorkView work={work} />
