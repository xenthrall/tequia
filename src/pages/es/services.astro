---
import PageShell from "../../layouts/PageShell.astro";
import ServicesContent from "../../components/ServicesContent.astro";
import { getServices } from "../../data/services";
import { getProfile } from "../../data/profile";

const locale = "es" as const;
const services = getServices(locale);
const profile = getProfile(locale);
---

<PageShell locale={locale} title={`${profile.name} — Servicios`} description={services.intro}>
  <ServicesContent locale={locale} />
</PageShell>
