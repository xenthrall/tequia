---
import PageShell from "../../layouts/PageShell.astro";
import HomeHero from "../../components/HomeHero.astro";
import WorkSection from "../../components/work/WorkSection.astro";
import Availability from "../../components/Availability.astro";
import { getProfile } from "../../data/profile";

const locale = "es" as const;
const profile = getProfile(locale);
---

<PageShell locale={locale} title={`${profile.name} — ${profile.role}`} description={profile.description}>
  <HomeHero locale={locale} />
  <WorkSection locale={locale} kind="project" linkToIndex />
  <WorkSection locale={locale} kind="experiment" linkToIndex />
  <Availability locale={locale} />
</PageShell>
