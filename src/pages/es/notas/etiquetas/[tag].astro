---
import NotesTagView from "../../../../components/notes/NotesTagView.astro";
import { getNotes, summarizeTags } from "../../../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes("es");
  return summarizeTags(notes).map(({ slug }) => ({ params: { tag: slug } }));
}
---

<NotesTagView locale="es" tag={Astro.params.tag} />
