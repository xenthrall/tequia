---
import NotesIndexView from "../../../../components/notes/NotesIndexView.astro";
import { extraPageNumbers, getNotes } from "../../../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes("es");
  return extraPageNumbers(notes).map((page) => ({ params: { page: String(page) } }));
}
---

<NotesIndexView locale="es" page={Number(Astro.params.page)} />
