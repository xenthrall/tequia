---
import PageShell from "../../layouts/PageShell.astro";
import Profile from "../../components/Profile.astro";
import AudienceSplit from "../../components/AudienceSplit.astro";
import Projects from "../../components/Projects.astro";
import Links from "../../components/Links.astro";
import Contact from "../../components/Contact.astro";
import { getProfile } from "../../data/profile";

const locale = "en" as const;
const profile = getProfile(locale);
---

<PageShell locale={locale} title={`${profile.name} — ${profile.role}`} description={profile.description}>
  <Profile locale={locale} />
  <AudienceSplit locale={locale} />
  <Projects locale={locale} />
  <Links locale={locale} />
  <Contact locale={locale} />
</PageShell>
