---
// Página 404 global del sitio. GitHub Pages sirve este archivo (compilado a
// /404.html) para cualquier ruta que no exista, sin cambiar la URL del
// navegador. Como no hay build-time context de la ruta real, el idioma se
// decide en el cliente a partir de location.pathname (¿empezaba por /es/?)
// y, si no se puede determinar, se muestra en inglés (default del sitio,
// ver docs/vision.md §11). El bloque "es" empieza oculto por CSS y un
// script inline en <head> (antes del primer paint) activa data-locale="es"
// en <html> cuando corresponde, para evitar parpadeos de contenido.
import "../styles/global.css";
import { withBase } from "../lib/base-url";
import { uiIcons } from "../icons/ui";
import { renderMascotIcon } from "../icons/mascot";
import { localizedPath } from "../i18n/config";

const enHome = localizedPath("/", "en");
const esHome = localizedPath("/", "es");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />

    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="alternate icon" href={withBase("favicon.ico")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Geist:wght@400..600&family=JetBrains+Mono:wght@500&display=swap"
    />

    <title>404 — Jhon Tequia</title>

    <style>
      [data-locale-content="es"] {
        display: none;
      }

      html[data-locale="es"] [data-locale-content="en"] {
        display: none;
      }

      html[data-locale="es"] [data-locale-content="es"] {
        display: block;
      }
    </style>

    <script is:inline>
      try {
        var storedTheme = localStorage.getItem("theme");
        var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        if (storedTheme === "light" || (!storedTheme && prefersLight)) {
          document.documentElement.classList.add("light-mode");
        }
      } catch {}

      if (location.pathname.replace(/\/+$/, "").split("/")[1] === "es") {
        document.documentElement.setAttribute("data-locale", "es");
      }
    </script>
  </head>

  <body>
    <main class="flex min-h-screen items-center justify-center bg-[var(--background)] px-[14px] py-10">

      <div class="w-[min(100%,440px)]">
        <header class="mb-4 flex justify-center">
          <button
            class="grid h-9 w-9 place-items-center rounded-full text-[var(--muted)] transition duration-150 hover:bg-[var(--card)] hover:text-[var(--text)] active:scale-[0.94] [&_svg]:h-[18px] [&_svg]:w-[18px]"
            type="button"
            id="theme-toggle"
            aria-label="Toggle appearance / Cambiar apariencia"
          >
            <Fragment set:html={uiIcons.theme} />
          </button>
        </header>

        <div class="tile px-6 py-10 text-center sm:px-10">
          <span class="mx-auto mb-2 inline-flex h-[58px] w-[66px]" aria-hidden="true">
            <Fragment set:html={renderMascotIcon()} />
          </span>

          <p class="display text-[clamp(4rem,18vw,6.5rem)] font-[300] italic leading-none text-[var(--accent)]">404</p>

          <div data-locale-content="en">
            <h1 class="mt-3 font-serif text-2xl font-normal text-[var(--text)]">Page not found</h1>
            <p class="mx-auto mt-2 max-w-[300px] text-[0.86rem] leading-relaxed text-[var(--muted)]">
              The page you're looking for doesn't exist or was moved.
            </p>
          </div>

          <div data-locale-content="es">
            <h1 class="mt-3 font-serif text-2xl font-normal text-[var(--text)]">Página no encontrada</h1>
            <p class="mx-auto mt-2 max-w-[300px] text-[0.86rem] leading-relaxed text-[var(--muted)]">
              La página que buscas no existe o fue movida.
            </p>
          </div>

          <div class="mt-6 flex justify-center" data-locale-content="en">
            <a
              href={enHome}
              class="inline-flex items-center gap-2 rounded-full bg-[var(--text)] px-5 py-3 text-sm font-semibold text-[var(--background)] no-underline transition hover:bg-[var(--accent)] hover:text-white [&_svg]:h-4 [&_svg]:w-4"
            >
              <Fragment set:html={uiIcons.arrowLeft} />
              Back to home
            </a>
          </div>

          <div class="mt-6 flex justify-center" data-locale-content="es">
            <a
              href={esHome}
              class="inline-flex items-center gap-2 rounded-full bg-[var(--text)] px-5 py-3 text-sm font-semibold text-[var(--background)] no-underline transition hover:bg-[var(--accent)] hover:text-white [&_svg]:h-4 [&_svg]:w-4"
            >
              <Fragment set:html={uiIcons.arrowLeft} />
              Volver al inicio
            </a>
          </div>

          <div class="mt-4 flex justify-center" data-locale-content="en">
            <a
              href={esHome}
              class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--soft)] no-underline transition hover:text-[var(--muted)] [&_svg]:h-3.5 [&_svg]:w-3.5"
            >
              <Fragment set:html={uiIcons.language} />
              Español
            </a>
          </div>

          <div class="mt-4 flex justify-center" data-locale-content="es">
            <a
              href={enHome}
              class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--soft)] no-underline transition hover:text-[var(--muted)] [&_svg]:h-3.5 [&_svg]:w-3.5"
            >
              <Fragment set:html={uiIcons.language} />
              English
            </a>
          </div>
        </div>
      </div>
    </main>

    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");

      themeToggle?.addEventListener("click", () => {
        const isLight = document.documentElement.classList.toggle("light-mode");

        try {
          localStorage.setItem("theme", isLight ? "light" : "dark");
        } catch {
          // Storage unavailable (e.g. private browsing).
        }
      });
    </script>
  </body>
</html>
